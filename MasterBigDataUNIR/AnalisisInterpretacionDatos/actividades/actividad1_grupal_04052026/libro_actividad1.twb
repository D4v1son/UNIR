      <aliases enabled='yes' />
      <column caption='precio_la_noche' datatype='real' name='[Calculation_1074288824057856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price] / [minimum_nights]' />
      </column>
      <column caption='rango_de_listings' datatype='string' name='[Calculation_2400574456504323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [calculated_host_listings_count] &lt; 10 THEN &quot;Menos de 10 listings por host&quot;&#13;&#10;ELSEIF [calculated_host_listings_count] &lt; 50 THEN &quot;Entre 10 y 49 listings por host&quot;&#13;&#10;ELSEIF [calculated_host_listings_count] &lt; 100 THEN &quot;Entre 50 y 99 listings por host&quot;&#13;&#10;ELSE &quot;100 o más listings por host&quot;&#13;&#10;END' />
      </column>
      <column caption='num_hosts' datatype='integer' name='[Calculation_2400574458806277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([host_id])' />
      </column>
      <column caption='media_listings_por_host' datatype='real' name='[Calculation_2400574493097992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([calculated_host_listings_count]) / COUNTD([host_id])' />
      </column>
      <column caption='media_listings_por_host_lt10' datatype='real' name='[Calculation_2400574493851657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [calculated_host_listings_count] &lt; 10 THEN [calculated_host_listings_count] END) / COUNTD(IF [calculated_host_listings_count] &lt; 10 THEN [host_id] END)' />
      </column>
      <column caption='categoria_licencia' datatype='string' name='[Calculation_2400574495723530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([license]) OR [license] = &quot;&quot; THEN &quot;Sin licencia&quot;&#13;&#10;ELSEIF [license] = &quot;Exempt&quot; THEN &quot;Exempt&quot;&#13;&#10;ELSE &quot;Con licencia&quot;&#13;&#10;END' />
      </column>
