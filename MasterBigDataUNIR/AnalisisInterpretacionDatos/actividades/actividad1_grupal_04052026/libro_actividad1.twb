  <worksheets>
    <worksheet name='precio_num_ofertas'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Precio por Noche sobre el Número de Ofertas por Ofertante</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontsize='11'>Precio individual de cada oferta por noche, excluyendo ofertas sin precio (la oferta no está activa),  sobre la cantidad total de ofertas en la página de Airbnb Madrid.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='listings-madrid-act1-grupal' name='federated.0i51oh71g5glh71ad900b0aq90sc' />
